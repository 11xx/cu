{
  "manifest_version": 3,
  "name": "CU Browser",
  "version": "0.1.0",
  "description": "Explicit Chromium-family page reads and optional interaction for CU.",
  "key": "",
  "minimum_chrome_version": "105",
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_title": "CU Browser",
    "default_popup": "popup.html"
  }
}
