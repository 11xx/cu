{
  "manifest_version": 3,
  "name": "CU Browser",
  "version": "0.1.0",
  "description": "Page reads and interaction for CU sessions in Chromium-family browsers.",
  "key": "",
  "minimum_chrome_version": "105",
  "permissions": [
    "scripting",
    "nativeMessaging",
    "storage",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_title": "CU Browser",
    "default_popup": "popup.html"
  }
}
